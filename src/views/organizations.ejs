<%- include('partials/head') %>

    <body>
        <%- include('partials/header') %>

            <main>
                <h1>
                    <%= locals.title || 'CSE 340 Service Network' %>
                </h1>
                <h2>Our Partner Organizations</h2>
                <p>Here are a few of our appreciated business partners:</p>
                <% if (locals.isAdmin) { %>
                <p><a class="button" href="/new-organization">Add an organization</a></p>
                <% } %>
                <ul>
                    <% organizations.forEach(organization=> { %>
                        <li>
                            <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                            <a href="/organization/<%= organization.organization_id %>"><strong><%= organization.name %></strong></a>: <%= organization.contact_email %>
                            <% if (locals.isAdmin) { %>
                            <a class="row-action" href="/edit-organization/<%= organization.organization_id %>"
                               aria-label="Edit <%= organization.name %>">Edit</a>
                            <% } %>
                        </li>
                        <% }); %>
                </ul>
                <noscript>
                    <p>Please enable JavaScript to see the organizations.</p>
                </noscript>
            </main>

            <script src="/js/organizations.js" defer></script>

            <%- include('partials/footer') %>
    </body>

    </html>
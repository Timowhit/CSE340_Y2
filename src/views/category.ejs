<%- include('partials/head') %>

<body>
    <%- include('partials/header') %>

    <main>
        <h1>Category</h1>
        <h2><%= category.name %></h2>
        <% if (projects.length === 0) { %>
            <p>No service projects in this category yet.</p>
        <% } else { %>
            <ul>
                <% projects.forEach(project => { %>
                    <li>
                        <a href="/project/<%= project.project_id %>"><strong><%= project.title %></strong></a><br>
                        <%= project.project_date %> · <%= project.location %>
                    </li>
                <% }); %>
            </ul>
        <% } %>
    </main>

    <%- include('partials/footer') %>
</body>

</html>
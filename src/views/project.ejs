<%- include('partials/head') %>

<body>
    <%- include('partials/header') %>

    <main>
        <h1>Service Project</h1>
        <h2><%= project.title %></h2>
        <%- include('partials/flash') %>
        <p><%= project.description %></p>
        <p>
            <strong>Date:</strong> <%= project.project_date %><br>
            <strong>Location:</strong> <%= project.location %><br>
            <strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
        </p>
        <p><a class="button" href="/edit-project/<%= project.project_id %>">Edit project</a></p>
        <% if (categories.length > 0) { %>
            <div class="tags" aria-label="Categories">
                <% categories.forEach(category => { %>
                    <a class="tag" href="/category/<%= category.category_id %>"><%= category.name %></a>
                <% }); %>
            </div>
        <% } %>
    </main>

    <%- include('partials/footer') %>
</body>

</html>
<%- include('partials/head') %>
<%- include('partials/header') %>

<main>
    <h1><%= locals.title || 'CSE 340 Service Network' %></h1>
    <h2>Categories</h2>
    <%- include('partials/flash') %>
    <p><a class="button" href="/new-category">Add a category</a></p>
    <ul>
        <% categories.forEach(category => { %>
            <li>
                <a href="/category/<%= category.category_id %>"><strong><%= category.name %></strong></a>
                <a class="row-action" href="/edit-category/<%= category.category_id %>"
                   aria-label="Edit <%= category.name %>">Edit</a>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>
<%- include('partials/head') %>

<body>
    <%- include('partials/header') %>

    <main>
        <h1>
            <%= locals.title || 'CSE 340 Service Network' %>
        </h1>
        <h2>Categories</h2>
        <ul>
            <% categories.forEach(category => { %>
                <li><a href="/category/<%= category.category_id %>"><strong><%= category.name %></strong></a></li>
            <% }); %>
        </ul>
    </main>

    <%- include('partials/footer') %>
</body>

</html>
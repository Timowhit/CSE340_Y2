<%- include('partials/head') %>

<body>
    <%- include('partials/header') %>

    <main>
    <h1><%= locals.title || 'CSE 340 Service Network' %></h1>
    <h2>Upcoming Service Projects</h2>
    <% if (projects.length === 0) { %>
        <p>No upcoming projects right now. Check back soon!</p>
    <% } else { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><strong><%= project.title %></strong></a><br>
                    <%= project.project_date %> ·
                    <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                </li>
            <% }); %>
        </ul>
    <% } %>
</main>

    <%- include('partials/footer') %>
</body>

</html>
<% if (errors.length > 0) { %>
    <div class="form-errors" role="alert" id="form-errors">
        <p><strong>Please fix the following:</strong></p>
        <% errors.forEach(error => { %>
            <p><%= error %></p>
        <% }); %>
    </div>
<% } %>

<form class="category-form" method="post" action="<%= formAction %>">
    <label for="name">Category name</label>
    <input
        type="text"
        id="name"
        name="name"
        value="<%= name %>"
        required
        maxlength="100"
        <%- errors.length > 0 ? 'aria-invalid="true" aria-describedby="form-errors"' : '' %>>
    <div class="form-actions">
        <button type="submit"><%= submitLabel %></button>
        <a href="/categories">Cancel</a>
    </div>
</form>
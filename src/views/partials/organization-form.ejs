<%- include('form-errors') %>

<% const invalid = (field) => errors.some(error => error.field === field); %>
<form class="record-form" method="post" action="<%= formAction %>">
    <%- include('csrf-field') %>
    <div class="form-field">
        <label for="name">Organization name</label>
        <input
            type="text"
            id="name"
            name="name"
            value="<%= values.name %>"
            required
            maxlength="150"
            <%- invalid('name') ? 'aria-invalid="true" aria-describedby="form-errors"' : '' %>>
    </div>

    <div class="form-field">
        <label for="description">Description</label>
        <textarea
            id="description"
            name="description"
            rows="6"
            required
            maxlength="1000"
            <%- invalid('description') ? 'aria-invalid="true" aria-describedby="form-errors"' : '' %>><%= values.description %></textarea>
    </div>

    <div class="form-field">
        <label for="contact_email">Contact email</label>
        <input
            type="email"
            id="contact_email"
            name="contact_email"
            value="<%= values.contact_email %>"
            required
            maxlength="255"
            <%- invalid('contact_email') ? 'aria-invalid="true" aria-describedby="form-errors"' : '' %>>
    </div>

    <div class="form-field">
        <label for="logo_filename">Logo file name</label>
        <input
            type="text"
            id="logo_filename"
            name="logo_filename"
            value="<%= values.logo_filename %>"
            required
            maxlength="255"
            aria-describedby="logo-hint<%- invalid('logo_filename') ? ' form-errors' : '' %>"
            <%- invalid('logo_filename') ? 'aria-invalid="true"' : '' %>>
        <p class="field-hint" id="logo-hint">The name of an image in <code>public/images</code>, such as <code>unityserve-logo.png</code>.</p>
    </div>

    <div class="form-actions">
        <button type="submit"><%= submitLabel %></button>
        <a href="<%= cancelHref %>">Cancel</a>
    </div>
</form>

diff --git a/src/middleware/csrf.js b/src/middleware/csrf.js
new file mode 100644
index 0000000..2ed27d5
--- /dev/null
+++ b/src/middleware/csrf.js
@@ -0,0 +1,50 @@
+import { randomBytes, timingSafeEqual } from 'node:crypto';
+
+// Synchronizer-token CSRF protection. A random token is stored in the server-side session and
+// embedded in every form as a hidden field. A forged cross-site POST cannot know the token, so
+// it is rejected. This needs no extra dependency because the session already exists.
+
+// Must match the hidden input's name in src/views/partials/csrf-field.ejs.
+const FIELD_NAME = '_csrf';
+const SAFE_METHODS = new Set(['GET', 'HEAD', 'OPTIONS']);
+
+/** Returns the session's token, creating it the first time a form needs one. */
+const getToken = (req) => {
+    if (!req.session.csrfToken) req.session.csrfToken = randomBytes(32).toString('hex');
+    return req.session.csrfToken;
+};
+
+/** Compares two strings in constant time (timingSafeEqual throws on different lengths). */
+const tokensMatch = (expected, submitted) => {
+    const a = Buffer.from(expected);
+    const b = Buffer.from(submitted);
+    return a.length === b.length && timingSafeEqual(a, b);
+};
+
+/**
+ * Adds `csrfToken()` to every view and rejects state-changing requests without a valid token.
+ * Mount after the session and after express.urlencoded, before the routes.
+ *
+ * `csrfToken` is a function, not a value, on purpose: the token is only created (and so a
+ * session only saved) when a page actually renders a form, not for every anonymous visitor.
+ * @type {import('express').RequestHandler}
+ */
+const csrfProtection = (req, res, next) => {
+    res.locals.csrfToken = () => getToken(req);
+
+    if (SAFE_METHODS.has(req.method)) return next();
+
+    const expected = req.session.csrfToken;
+    const submitted = req.body?.[FIELD_NAME];
+
+    if (typeof expected === 'string' && typeof submitted === 'string' && tokensMatch(expected, submitted)) {
+        return next();
+    }
+
+    res.status(403).render('errors/403', {
+        title: 'Form Expired',
+        message: 'Your form could not be verified. It may have expired. Go back, reload the page, and try again.'
+    });
+};
+
+export { csrfProtection };
diff --git a/src/middleware/rateLimit.js b/src/middleware/rateLimit.js
new file mode 100644
index 0000000..c50a1de
--- /dev/null
+++ b/src/middleware/rateLimit.js
@@ -0,0 +1,39 @@
+import { rateLimit } from 'express-rate-limit';
+
+// Counters live in this process's memory, which is fine for a single server instance: they
+// reset on restart and are not shared between instances. Behind a proxy (production), the
+// client address comes from `trust proxy`, which server.js sets.
+
+const tooManyRequests = (message) => (req, res) => {
+    res.status(429).render('errors/429', { title: 'Too Many Requests', message });
+};
+
+const baseOptions = {
+    standardHeaders: true, // sends the standard RateLimit-* headers
+    legacyHeaders: false   // skips the old X-RateLimit-* headers
+};
+
+/**
+ * Limits password guessing: 10 failed logins per address per 15 minutes.
+ * Successful logins (the redirect after login) are not counted.
+ */
+const loginLimiter = rateLimit({
+    ...baseOptions,
+    windowMs: 15 * 60 * 1000,
+    limit: 10,
+    skipSuccessfulRequests: true,
+    handler: tooManyRequests('Too many failed login attempts. Please wait 15 minutes and try again.')
+});
+
+/**
+ * Limits account creation: 10 attempts per address per hour. Registration runs the password
+ * hasher, which is deliberately slow, so an unlimited public endpoint could be used to tie up the server.
+ */
+const registerLimiter = rateLimit({
+    ...baseOptions,
+    windowMs: 60 * 60 * 1000,
+    limit: 10,
+    handler: tooManyRequests('Too many registration attempts. Please wait an hour and try again.')
+});
+
+export { loginLimiter, registerLimiter };
